# Copy to .env (the installers write this for you). Every line is optional.

# Where the web app listens.
PORT='4477'
# 127.0.0.1: this machine only. 0.0.0.0: reachable from other machines; PRETTY_PASSWORD is then required.
HOST='127.0.0.1'
# Asked for in the browser before anything is shown. At least 8 characters.
PRETTY_PASSWORD=''

# Database, saved sessions and settings. Small.
# Default: %LOCALAPPDATA%\PrettySuite on Windows, ~/.local/share/PrettySuite elsewhere.
PRETTY_DATA_DIR=''
# Archived attachments: the part that grows. Point it at the disk with room.
# Default: <data>/attachments
PRETTY_CONTENT_DIR=''
# Throwaway files (the browser profile used by the separate login window).
# Default: <data>/login-profiles
PRETTY_CACHE_DIR=''
